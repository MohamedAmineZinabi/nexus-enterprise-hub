# ==============================================================================
# NexusEnterprise Hub - Environment Configuration Blueprint
#
# Copy to .env and replace EVERY "change-me" value before starting the stack.
# docker compose refuses to start while a required secret is missing.
# Generate strong values with, for example:
#   openssl rand -hex 32        (bash)
#   -join ((1..32) | % { '{0:x2}' -f (Get-Random -Max 256) })   (PowerShell)
# ==============================================================================

COMPOSE_PROJECT_NAME=nexus-hub

# --- PostgreSQL Configuration ---
POSTGRES_DB=nexus_db
POSTGRES_USER=nexus_admin
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_PORT=5432

# --- Redis Configuration ---
REDIS_PASSWORD=change-me-redis-password
REDIS_PORT=6379

# --- Qdrant Configuration (API key required on every request) ---
QDRANT_API_KEY=change-me-qdrant-api-key
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# --- Kafka Configuration (KRaft Mode) ---
KAFKA_HOST_PORT=9092
KAFKA_INTERNAL_PORT=29092
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# --- Authentication ---
# HS256 signing key for user JWTs: at least 32 characters (64 hex chars recommended)
JWT_SECRET=change-me-generate-64-hex-characters-with-openssl-rand-hex-32
# Shared secret for core-service -> ai-service calls (gRPC metadata x-internal-api-key
# and the X-Internal-Api-Key HTTP header). At least 16 characters.
INTERNAL_API_KEY=change-me-internal-service-api-key

# --- Optional LLM (any OpenAI-compatible API: OpenAI, Groq, Ollama, vLLM) ---
# Leave LLM_API_KEY empty to run the agents in honest deterministic (extractive) mode.
LLM_API_KEY=
# e.g. https://api.groq.com/openai/v1 or http://host.docker.internal:11434/v1 (Ollama); empty = OpenAI
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
MAX_AGENT_ITERATIONS=2

# --- Local development port bindings (docker-compose.override.yml, 127.0.0.1 only) ---
FRONTEND_PORT=4200
CORE_SERVICE_PORT=8080
AI_SERVICE_HTTP_PORT=8000
AI_SERVICE_GRPC_PORT=50051
